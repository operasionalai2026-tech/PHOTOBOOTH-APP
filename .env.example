# Semua variabel di bawah ini AMAN di-expose ke browser (NEXT_PUBLIC_*).
# JANGAN pernah taruh SUPABASE_SERVICE_ROLE_KEY di sini — itu hanya di GitHub Secrets.

NEXT_PUBLIC_SUPABASE_URL=https://kocmlvnudnjtxknhrsrq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_EVENT_SLUG=nama-event
NEXT_PUBLIC_BASE_URL=https://photobooth-app-72y.pages.dev

# Opsional — nama event yang tampil di frame & layar awal
NEXT_PUBLIC_EVENT_NAME=Photobooth
# Opsional — tanggal/tagline kecil di bawah nama event (mis. "12.10.2026")
NEXT_PUBLIC_EVENT_TAGLINE=

# Opsional — email kontak yang tampil di halaman /privacy (untuk permintaan hapus foto).
NEXT_PUBLIC_CONTACT_EMAIL=

# Opsional — aktifkan tombol "Simpan ke Google Drive".
# OAuth Client ID tipe "Web application" dari Google Cloud Console (gratis).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
